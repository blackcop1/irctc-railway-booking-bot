# IRCTC Credentials
IRCTC_USERNAME=your_username
IRCTC_PASSWORD=your_password
IRCTC_USER_ID=1

# Captcha API Key (2Captcha)
CAPTCHA_API_KEY=your_2captcha_api_key

# Booking Details
FROM_STATION=NDLS  # New Delhi
TO_STATION=MMCT   # Mumbai Central
TRAVEL_DATE=15-05-2026  # DD-MM-YYYY format

# Booking Preferences
CLASS_TYPE=SL  # SL=Sleeper, AC2=AC 2-Tier, AC3=AC 3-Tier, 1A=1st AC, 2A=2nd AC, 3A=3rd AC
QUOTA=GN  # GN=General, TQ=Tatkal, PT=Premium Tatkal, RL=Railway Staff
PASSENGERS_JSON=[{"name":"Alice","age":29,"gender":"F","berth_preference":"LB"}]

# Browser Settings
HEADLESS=false  # Run browser in headless mode (true/false)

# Logging
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL

# Database
DATABASE_PATH=data/booking.db

# Notification Settings
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_SMS_NOTIFICATIONS=false
ENABLE_TELEGRAM_NOTIFICATIONS=false

# Email Configuration (for notifications)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
NOTIFICATION_EMAIL=recipient@gmail.com

# Telegram Configuration (for notifications)
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# Advanced Settings
USE_NTP_SYNC=true  # Synchronize time with NTP servers
MAX_RETRIES=5
BOOKING_TIMEOUT=300  # seconds
AUTO_RETRY_ON_FAILURE=true
